{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": [
			"$app/types",
			"node",
			"./worker-configuration.d.ts"
		],
		"allowJs": true,
		"checkJs": false,
		"paths": {
			"#lib/*": [
				"./src/lib/*"
			]
		}
	},
	"include": [
		"src",
		"vite.config.ts",
		"playwright.config.ts",
		"e2e"
	]
}
